{
  "uid": "hookrelay-main",
  "title": "HookRelay — Teslimat",
  "tags": [
    "hookrelay"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Teslimat hizi (saniyede)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(hookrelay_dispatch_succeeded_total[1m]))",
          "legendFormat": "basarili",
          "refId": "A"
        },
        {
          "expr": "sum(rate(hookrelay_dispatch_failed_total[1m]))",
          "legendFormat": "basarisiz",
          "refId": "B"
        },
        {
          "expr": "sum(rate(hookrelay_dispatch_rescheduled_total[1m]))",
          "legendFormat": "yeniden zamanlanan",
          "refId": "C"
        },
        {
          "expr": "sum(rate(hookrelay_dispatch_dead_lettered_total[1m]))",
          "legendFormat": "DLQ",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Basari orani",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(hookrelay_dispatch_succeeded_total[5m])) / clamp_min(sum(rate(hookrelay_dispatch_succeeded_total[5m])) + sum(rate(hookrelay_dispatch_failed_total[5m])), 0.001)",
          "legendFormat": "oran",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "HTTP gecikmesi (p50 / p95 / p99)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(hookrelay_dispatch_http_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(hookrelay_dispatch_http_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(hookrelay_dispatch_http_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Engellemeler (devre kesici / hiz siniri)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(hookrelay_dispatch_short_circuited_total[1m]))",
          "legendFormat": "devre kesici",
          "refId": "A"
        },
        {
          "expr": "sum(rate(hookrelay_dispatch_rate_limited_total[1m]))",
          "legendFormat": "hiz siniri",
          "refId": "B"
        },
        {
          "expr": "sum(rate(hookrelay_dispatch_skipped_duplicate_total[1m]))",
          "legendFormat": "mukerrer atlandi",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Kafka tuketici gecikmesi (lag)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(kafka_consumer_fetch_manager_records_lag) by (client_id)",
          "legendFormat": "{{client_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Outbox: yayinlanan / basarisiz",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 14,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(hookrelay_outbox_published_total[1m]))",
          "legendFormat": "yayinlanan",
          "refId": "A"
        },
        {
          "expr": "sum(rate(hookrelay_outbox_failed_total[1m]))",
          "legendFormat": "basarisiz",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Zamanlayici: duraklatilmis partition",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "hookrelay_scheduler_paused_partitions",
          "legendFormat": "duraklatilmis",
          "refId": "A"
        },
        {
          "expr": "sum(rate(hookrelay_scheduler_forwarded_total[1m]))",
          "legendFormat": "ileri gonderilen/sn",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Giris: kabul edilen / mukerrer",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(hookrelay_ingest_accepted_total[1m]))",
          "legendFormat": "kabul",
          "refId": "A"
        },
        {
          "expr": "sum(rate(hookrelay_ingest_duplicates_total[1m]))",
          "legendFormat": "mukerrer",
          "refId": "B"
        },
        {
          "expr": "sum(rate(hookrelay_ingest_deliveries_created_total[1m]))",
          "legendFormat": "uretilen teslimat",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "JVM bellek (heap kullanimi)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) by (instance)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Toplam DLQ",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(hookrelay_dispatch_dead_lettered_total)",
          "legendFormat": "DLQ",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 11,
      "title": "Toplam teslim",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 28,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(hookrelay_dispatch_succeeded_total)",
          "legendFormat": "basarili",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    }
  ]
}